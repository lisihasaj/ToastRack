@namespace ToastRack.Components
@using System.Globalization
@using Microsoft.JSInterop
@inject IToastService ToastService
@inject IJSRuntime JSRuntime

@implements IAsyncDisposable

@foreach (var group in ToastService.ToastsByPosition)
{
    <div id="@ContainerId(group.Key)"
         class="@ContainerClass(group.Key)"
         style="@PositionStyle(group.Key)"
         @key="@group.Key">
        @foreach (var toast in group.Value)
        {
            <Toast @key="@toast.ToastId"
                   Item="@toast"
                   AnimationClass="@SlideInClass(group.Key)"/>
        }
    </div>
}

@code {

    /// <summary>
    /// Optional CSS selector of an element toasts should be positioned within (e.g. the main
    /// content area next to a sidebar). The element is tracked with a <c>ResizeObserver</c>, so
    /// toasts follow it automatically. Leave <c>null</c> to anchor toasts to the viewport.
    /// </summary>
    [Parameter] public string? BoundarySelector { get; set; }

    private ToastRackJsInterop? _js;
    private BoundaryRect? _boundary;
    private bool _shouldScrollTopGroups;
    private DotNetObjectReference<ToastRack>? _dotNetRef;
    private bool _boundaryObserved;

    private static string PositionClass(ToastPosition position) => position switch
    {
        ToastPosition.TopLeft => "toastrack--top-left",
        ToastPosition.TopRight => "toastrack--top-right",
        ToastPosition.TopCenter => "toastrack--top-center",
        ToastPosition.BottomLeft => "toastrack--bottom-left",
        ToastPosition.BottomRight => "toastrack--bottom-right",
        ToastPosition.BottomCenter => "toastrack--bottom-center",
        _ => "toastrack--bottom-left",
    };

    private string ContainerClass(ToastPosition position) =>
        _boundary is null
            ? $"toastrack {PositionClass(position)}"
            : $"toastrack toastrack--bound {PositionClass(position)}";

    private static string ContainerId(ToastPosition position) => $"toastrack{position}";

    private static string SlideInClass(ToastPosition position) => position switch
    {
        ToastPosition.BottomLeft or ToastPosition.BottomRight or ToastPosition.BottomCenter =>
            "toastrack-animate-slide-up",
        _ => "toastrack-animate-slide-down",
    };

    private string? PositionStyle(ToastPosition position)
    {
        if (_boundary is not { } rect) return null;

        var (left, top) = position switch
        {
            ToastPosition.TopLeft => (rect.Left, rect.Top),
            ToastPosition.TopRight => (rect.Left + rect.Width, rect.Top),
            ToastPosition.TopCenter => (rect.Left + (rect.Width / 2), rect.Top),
            ToastPosition.BottomLeft => (rect.Left, rect.Top + rect.Height),
            ToastPosition.BottomRight => (rect.Left + rect.Width, rect.Top + rect.Height),
            _ => (rect.Left + (rect.Width / 2), rect.Top + rect.Height),
        };

        return string.Create(
            CultureInfo.InvariantCulture,
            $"left: {left}px; top: {top}px; max-height: {rect.Height}px;");
    }

    protected override void OnInitialized()
    {
        _js = new ToastRackJsInterop(JSRuntime);
        _dotNetRef = DotNetObjectReference.Create(this);
        ToastService.ToastsUpdated += OnToastsUpdated;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && BoundarySelector is not null && _js is not null && _dotNetRef is not null)
        {
            _boundaryObserved = await _js.ObserveBoundaryAsync(
                BoundarySelector, _dotNetRef, nameof(OnBoundaryChanged));
        }

        if (!_shouldScrollTopGroups || _js is null) return;

        _shouldScrollTopGroups = false;

        foreach (var group in ToastService.ToastsByPosition.Where(group => IsTopPosition(group.Key)))
        {
            await _js.ScrollToBottomAsync(ContainerId(group.Key));
        }

        return;

        static bool IsTopPosition(ToastPosition position) =>
            position is ToastPosition.TopLeft or ToastPosition.TopRight or ToastPosition.TopCenter;
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        ToastService.ToastsUpdated -= OnToastsUpdated;

        if (_js is not null)
        {
            if (_boundaryObserved)
            {
                _boundaryObserved = false;
                await _js.UnobserveBoundaryAsync();
            }

            await _js.DisposeAsync();
        }

        _dotNetRef?.Dispose();
    }

    /// <summary>Invoked from JS whenever the boundary element's rectangle changes.</summary>
    [JSInvokable]
    public void OnBoundaryChanged(BoundaryRect rect)
    {
        _boundary = rect;
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnToastsUpdated()
    {
        _shouldScrollTopGroups = true;
        _ = InvokeAsync(StateHasChanged);
    }

}
