    private string PlaygroundCode
    {
        get
        {
            var title = Quote(_pgTitle);
            var hasCaption = !string.IsNullOrWhiteSpace(_pgCaption);

            if (_pgExpiry is null && !_pgWithActions)
            {
                var args = new List<string> { $"\"{title}\"" };
                if (hasCaption) args.Add($"\"{Quote(_pgCaption)}\"");
                if (_pgPosition != ToastPosition.BottomLeft) args.Add($"position: ToastPosition.{_pgPosition}");
                return $"Toasts.{_pgVariant}({string.Join(", ", args)});";
            }

            var sb = new StringBuilder();
            sb.AppendLine($"Toasts.Show{_pgVariant}Toast(new ToastOptions");
            sb.AppendLine("{");
            sb.AppendLine($"    Title = \"{title}\",");
            if (hasCaption) sb.AppendLine($"    Caption = \"{Quote(_pgCaption)}\",");
            if (_pgPosition != ToastPosition.BottomLeft) sb.AppendLine($"    Position = ToastPosition.{_pgPosition},");
            if (_pgExpiry is { } expiry) sb.AppendLine($"    Expiry = {expiry},");
            if (_pgWithActions)
            {
                sb.AppendLine("    Actions =");
                sb.AppendLine("    [");
                sb.AppendLine("        new ToastAction { Label = \"Undo\", OnClick = Undo },");
                sb.AppendLine("        new ToastAction { Label = \"Dismiss\", Style = ToastActionStyle.Text },");
                sb.AppendLine("    ],");
            }

            sb.Append("});");
            return sb.ToString();
        }
    }

    private static string Quote(string value) =>
        value.Replace("\\", "\\\\").Replace("\"", "\\\"");

    private void ShowPlaygroundToast() =>
        Toasts.ShowToast(new ToastOptions
        {
            Variant = _pgVariant,
            Position = _pgPosition,
            Title = _pgTitle,
            Caption = string.IsNullOrWhiteSpace(_pgCaption) ? null : _pgCaption,
            Expiry = _pgExpiry,
            Actions = _pgWithActions
                ?
                [
                    new ToastAction
                    {
                        Label = "Undo",
                        Style = ToastActionStyle.Primary,
                        OnClick = () => Toasts.Success("Undone", "Your playground action ran.", _pgPosition),
                    },
                    new ToastAction
                    {
                        Label = "Dismiss",
                        Style = ToastActionStyle.Text,
                    },
                ]
                : null,
        });

