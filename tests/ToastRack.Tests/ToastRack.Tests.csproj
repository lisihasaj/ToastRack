<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0 (oldest supported target) and net10.0 (newest). CI runs both; locally run
         `dotnet test -f net10.0` if only the .NET 10 runtime is installed. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <!-- CA1707: underscores are the standard naming convention for test methods. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
    <!-- Signed with the library's key so InternalsVisibleTo grants access to internals. -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\src\ToastRack\ToastRack.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Direct reference lifts bunit's transitive AngleSharp 1.2.0, which has a known
         vulnerability (GHSA-pgww-w46g-26qg), to a patched version. -->
    <PackageReference Include="AngleSharp" Version="1.7.0" />
    <PackageReference Include="bunit" Version="2.9.0" />
    <PackageReference Include="coverlet.collector" Version="10.0.1" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ToastRack\ToastRack.csproj" />
  </ItemGroup>

</Project>
